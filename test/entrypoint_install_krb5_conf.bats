#!/usr/bin/env bats
load helpers "/pdc/entrypoint.sh"

function setup() {
    KRB5_CONF_FILE="$(mktemp -u)"
    mkdir -p /var/lib/samba/private /var/lib/restored_samba/private
    echo "samba" > /var/lib/samba/private/krb5.conf
    echo "restored_samba" > /var/lib/restored_samba/private/krb5.conf
    FLAG_USERS_KRB5_CONF=0
}

function teardown() {
    rm -f "$KRB5_CONF_FILE" /var/lib/samba/private/krb5.conf /var/lib/restored_samba/private/krb5.conf
    unset RESTORE_FROM
}

@test '#install_krb5_conf should copy krb5.conf generated by samba' {
    run install_krb5_conf; command echo "$output"

    [[ "$status" -eq 0 ]]
    [[ "$(cat "$KRB5_CONF_FILE")" == "samba" ]]
}

@test '#install_krb5_conf should copy krb5.conf of restored samba if RESTORE_FROM=BACKUP_FILE' {
    export RESTORE_FROM="BACKUP_FILE"
    run install_krb5_conf; command echo "$output"

    [[ "$status" -eq 0 ]]
    [[ "$(cat "$KRB5_CONF_FILE")" == "restored_samba" ]]
}

@test '#install_krb5_conf should copy krb5.conf generated by samba if RESTORE_FROM=JOINING_DOMAIN' {
    export RESTORE_FROM="JOINING_DOMAIN"
    run install_krb5_conf; command echo "$output"

    [[ "$status" -eq 0 ]]
    [[ "$(cat "$KRB5_CONF_FILE")" == "samba" ]]
}

@test '#install_krb5_conf should overwrite temporary krb5.conf written before joining a domain' {
    echo "temporary" > "$KRB5_CONF_FILE"
    run install_krb5_conf; command echo "$output"

    [[ "$status" -eq 0 ]]
    [[ "$(cat "$KRB5_CONF_FILE")" == "samba" ]]
}

@test '#install_krb5_conf should not modify krb5.conf mounted by a user' {
    echo "users" > "$KRB5_CONF_FILE"
    FLAG_USERS_KRB5_CONF=1
    stub cp
    run install_krb5_conf; command echo "$output"

    [[ "$status" -eq 0 ]]
    [[ "$(stub_called_times cp)" -eq 0 ]]
    [[ "$(cat "$KRB5_CONF_FILE")" == "users" ]]
}

@test '#install_krb5_conf should return 0 with a warning if krb5.conf generated by samba does not exist' {
    rm -f /var/lib/samba/private/krb5.conf
    run install_krb5_conf

    [[ "$status" -eq 0 ]]
    [[ ! -f "$KRB5_CONF_FILE" ]]
    [[ "$output" == "WARNING: /var/lib/samba/private/krb5.conf generated by samba does not exist. ${KRB5_CONF_FILE} will not be installed." ]]
}

@test '#install_krb5_conf should return 0 with a warning if cp has failed' {
    stub_and_eval cp '{ return 1; }'
    run install_krb5_conf

    [[ "$status" -eq 0 ]]
    [[ "$(stub_called_times cp)" -eq 1 ]]
    stub_called_with_exactly_times cp 1 "-f" "/var/lib/samba/private/krb5.conf" "$KRB5_CONF_FILE"
    [[ "$output" == "WARNING: Failed to copy /var/lib/samba/private/krb5.conf to ${KRB5_CONF_FILE}." ]]
}
